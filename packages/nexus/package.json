{
  "name": "@symbiote/nexus",
  "version": "0.0.0",
  "description": "Symbiote nexus: every running symbiote view on this machine, as tabs in one window (NX1).",
  "private": true,
  "type": "module",
  "bin": {
    "symbiote-nexus": "./dist/bin.js"
  },
  "exports": {
    "./registry": {
      "types": "./dist/registry.d.ts",
      "default": "./dist/registry.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "page"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@symbiote/desktop": "workspace:*",
    "@symbiote/log": "workspace:*",
    "@symbiote/viewer": "workspace:*"
  }
}
