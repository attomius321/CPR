{
  "name": "@symbiote/cli",
  "version": "0.0.0",
  "description": "Symbiote command line: symbiote diff, symbiote view, symbiote pr.",
  "private": true,
  "type": "module",
  "bin": {
    "symbiote": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@symbiote/core": "workspace:*",
    "@symbiote/desktop": "workspace:*",
    "@symbiote/forge": "workspace:*",
    "@symbiote/log": "workspace:*",
    "@symbiote/monitor": "workspace:*",
    "@symbiote/nexus": "workspace:*",
    "@symbiote/viewer": "workspace:*",
    "jsonc-parser": "3.3.1"
  },
  "optionalDependencies": {
    "@lydell/node-pty": "1.1.0"
  }
}
