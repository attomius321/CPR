{
  "name": "symbiote-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json && pnpm --filter @symbiote/viewer run build",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "test:e2e": "pnpm --filter @symbiote/viewer run test:e2e",
    "logs:up": "node ops/logs/logs.mjs up",
    "logs:down": "node ops/logs/logs.mjs down",
    "logs:check": "node ops/logs/logs.mjs check",
    "app:setup": "node packages/desktop/node_modules/electron/install.js"
  },
  "devDependencies": {
    "@symbiote/plugin-angular": "workspace:*",
    "@symbiote/plugin-qwik": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
