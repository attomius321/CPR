new file mode 100644
index 0000000..6961d75
--- /dev/null
+++ b/packages/viewer/src/workspaces/push.ts
@@ -0,0 +1,65 @@
+// SPIKE: the shell's state as the server pushes it (`/api/events`): one stream per page, the whole
+// state on each connect, then the parts that changed. Unavailable (404, `?poll`): polling as today.
+
+export type Status = 'streaming' | 'reconnecting' | 'unavailable';
+export type Parts = Record<string, unknown>;
+type Listener = (parts: Parts, whole: boolean) => void;
+type StatusListener = (status: Status) => void;
+
+const listeners = new Set<Listener>();
+const statusListeners = new Set<StatusListener>();
+let source: EventSource | null = null;
+let status: Status | null = null;
+
+export const pushStatus = (): Status | null => status;
+
+function setStatus(next: Status): void {
+  if (status === next) return;
+  status = next;
+  for (const listener of statusListeners) listener(next);
+}
+
+function open(): void {
+  if (typeof EventSource === 'undefined' || new URLSearchParams(location.search).has('poll')) {
+    setStatus('unavailable');
+    return;
+  }
+  const es = new EventSource('/api/events');
+  source = es;
+  let opened = false;
+  es.addEventListener('state', (e) => {
+    opened = true;
+    setStatus('streaming');
+    const { parts } = JSON.parse((e as MessageEvent<string>).data) as { parts: Parts };
+    for (const listener of listeners) listener(parts, true);
+  });
+  es.addEventListener('change', (e) => {
+    const { parts } = JSON.parse((e as MessageEvent<string>).data) as { parts: Parts };
+    for (const listener of listeners) listener(parts, false);
+  });
+  es.onerror = () => {
+    // A 404 or another type closes it for good; a lost connection is tried again (`retry`).
+    if (es.readyState === EventSource.CLOSED) {
+      source = null;
+      setStatus(opened ? 'reconnecting' : 'unavailable');
+      if (opened) setTimeout(open, 1000);
+    } else setStatus('reconnecting');
+  };
+}
+
+/** Listens to the pushed state; the stream opens with the first listener and closes with the last. */
+export function subscribe(listener: Listener, onStatus: StatusListener): () => void {
+  listeners.add(listener);
+  statusListeners.add(onStatus);
+  if (!source && status !== 'unavailable') open();
+  else if (status) onStatus(status);
+  return () => {
+    listeners.delete(listener);
+    statusListeners.delete(onStatus);
+    if (listeners.size === 0) {
+      source?.close();
+      source = null;
+      if (status !== 'unavailable') status = null;
+    }
+  };
+}
