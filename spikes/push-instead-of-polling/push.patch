diff --git a/packages/cli/src/hook-ping.ts b/packages/cli/src/hook-ping.ts
new file mode 100644
index 0000000..3d1c880
--- /dev/null
+++ b/packages/cli/src/hook-ping.ts
@@ -0,0 +1,110 @@
+// SPIKE: a hook tells the running `symbiote view` of its `symbiote/` folder that it wrote, found
+// through the registry (`<cache>/running/<pid>.json`). `SPIKE_PING`: `off`, `http` (waits for the
+// answer, 150 ms at most), `nowait` (the request sent, no answer waited for), `udp` (one datagram).
+// Never throws, never waits longer than the cap: a hook must not slow or fail the agent.
+import { readdirSync, readFileSync } from 'node:fs';
+import { homedir } from 'node:os';
+import { dirname, join } from 'node:path';
+
+const CAP_MS = 150;
+
+function cacheDir(): string {
+  const env = process.env;
+  if (env.SYMBIOTE_CACHE_DIR) return env.SYMBIOTE_CACHE_DIR;
+  if (env.XDG_CACHE_HOME) return join(env.XDG_CACHE_HOME, 'symbiote');
+  if (process.platform === 'darwin') return join(homedir(), 'Library', 'Caches', 'symbiote');
+  return join(homedir(), '.cache', 'symbiote');
+}
+
+/** The ports of the views serving the checkout that holds `symbiote`. */
+export function viewPorts(symbiote: string): number[] {
+  const root = dirname(symbiote);
+  const dir = join(cacheDir(), 'running');
+  const ports: number[] = [];
+  let names: string[] = [];
+  try {
+    names = readdirSync(dir).filter((n) => n.endsWith('.json'));
+  } catch {
+    return ports;
+  }
+  for (const name of names) {
+    try {
+      const record = JSON.parse(readFileSync(join(dir, name), 'utf8')) as { url?: string; root?: string };
+      if (record.root !== root || !record.url) continue;
+      const port = Number(new URL(record.url).port);
+      if (port) ports.push(port);
+    } catch {
+      // Not a record.
+    }
+  }
+  return ports;
+}
+
+export async function ping(symbiote: string, how = process.env.SPIKE_PING ?? 'off'): Promise<void> {
+  if (how === 'off') return;
+  const ports = viewPorts(symbiote);
+  if (ports.length === 0) return;
+  if (how === 'udp') {
+    const { createSocket } = await import('node:dgram');
+    const socket = createSocket('udp4');
+    await Promise.all(
+      ports.map((port) => new Promise<void>((resolve) => socket.send('w', port, '127.0.0.1', () => resolve()))),
+    );
+    socket.close();
+    return;
+  }
+  if (how === 'net' || how === 'netflush') {
+    // The same POST, written on a bare socket: node:http is most of the cost.
+    const { connect } = await import('node:net');
+    await Promise.all(
+      ports.map(
+        (port) =>
+          new Promise<void>((resolve) => {
+            const socket = connect(port, '127.0.0.1');
+            const done = () => {
+              socket.destroy();
+              resolve();
+            };
+            socket.setTimeout(CAP_MS, done);
+            socket.on('error', done);
+            socket.on('close', done);
+            socket.on('data', done);
+            // `netflush`: done once the request is written, its answer not waited for.
+            if (how === 'netflush') socket.on('finish', done);
+            socket.end(
+              `POST /api/events/ping HTTP/1.1\r\nhost: 127.0.0.1:${port}\r\nx-symbiote: 1\r\ncontent-type: application/json\r\ncontent-length: 2\r\nconnection: close\r\n\r\n{}`,
+            );
+          }),
+      ),
+    );
+    return;
+  }
+  const { request } = await import('node:http');
+  await Promise.all(
+    ports.map(
+      (port) =>
+        new Promise<void>((resolve) => {
+          const req = request({
+            host: '127.0.0.1',
+            port,
+            method: 'POST',
+            path: '/api/events/ping',
+            headers: { 'content-type': 'application/json', 'x-symbiote': '1', 'content-length': 2 },
+            timeout: CAP_MS,
+          });
+          const done = () => {
+            req.destroy();
+            resolve();
+          };
+          req.on('error', done);
+          req.on('timeout', done);
+          req.on('response', (res) => {
+            res.resume();
+            done();
+          });
+          if (how === 'nowait') req.on('finish', done);
+          req.end('{}');
+        }),
+    ),
+  );
+}
