diff --git a/packages/cli/src/push.ts b/packages/cli/src/push.ts
new file mode 100644
index 0000000..ea867bc
--- /dev/null
+++ b/packages/cli/src/push.ts
@@ -0,0 +1,273 @@
+// SPIKE (push instead of polling): one server-sent stream of the shell's state. On every connect
+// the whole state; then only the parts whose JSON changed, after a trigger: a hook's ping, a file
+// watched, a change in memory, or the slow safety read. `SPIKE_PUSH` picks the triggers:
+// `ping`, `watch`, `both` (default) — merges and asks are pushed from memory in each.
+import { readdirSync, statSync, watch, type FSWatcher } from 'node:fs';
+import { createSocket } from 'node:dgram';
+import { join } from 'node:path';
+import { execFileSync } from 'node:child_process';
+import type { IncomingMessage, ServerResponse } from 'node:http';
+
+export type Part = 'workspaces' | 'reviews' | 'merges' | 'nucleus' | 'scribe' | 'asks';
+export const PARTS: Part[] = ['workspaces', 'reviews', 'merges', 'nucleus', 'scribe', 'asks'];
+
+/** Changes in this process that pages should see: the merge queue written, an ask held or let go. */
+export const bus = new EventTarget();
+export const changed = (part: Part) => bus.dispatchEvent(new CustomEvent('part', { detail: part }));
+
+/** Whether the next read of Claude Code's sessions skips its 2 s cache (set by a trigger). */
+export const fresh = { sessions: false };
+
+export interface PushOptions {
+  read: Partial<Record<Part, () => Promise<unknown>>>;
+  /** The checkout the server runs in: its `symbiote/` and git's common folder are watched. */
+  root: string;
+  port: number;
+  log?: (fields: Record<string, unknown>, msg: string) => void;
+}
+
+const env = process.env;
+const MODE = env.SPIKE_PUSH ?? 'both';
+const SAFETY_MS = Number(env.SPIKE_SAFETY_MS ?? 60_000);
+const DEBOUNCE_MS = Number(env.SPIKE_DEBOUNCE_MS ?? 30);
+const KEEPALIVE_MS = 25_000;
+/** After a hook's ping, Claude Code's own list may say the new state a little later: read again. */
+const SETTLE_MS = (env.SPIKE_SETTLE_MS ?? '300,1000,2500').split(',').map(Number).filter(Boolean);
+
+export function pushStream(options: PushOptions) {
+  const clients = new Set<ServerResponse>();
+  const last = new Map<Part, string>();
+  const pending = new Set<Part>();
+  const why = new Set<string>();
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  let running: Promise<void> | null = null;
+  const stats = { triggers: 0, runs: 0, sent: 0, bytes: 0, reads: {} as Record<string, number> };
+
+  const write = (res: ServerResponse, text: string) => {
+    stats.bytes += Buffer.byteLength(text);
+    res.write(text);
+  };
+  const event = (name: string, data: unknown) => {
+    const text = `event: ${name}\ndata: ${JSON.stringify(data)}\n\n`;
+    for (const res of clients) write(res, text);
+    stats.sent++;
+  };
+
+  async function readParts(parts: Iterable<Part>): Promise<Map<Part, string>> {
+    const out = new Map<Part, string>();
+    await Promise.all(
+      [...parts].map(async (part) => {
+        const read = options.read[part];
+        if (!read) return;
+        stats.reads[part] = (stats.reads[part] ?? 0) + 1;
+        try {
+          out.set(part, JSON.stringify(await read()));
+        } catch {
+          // A failed read sends nothing: the last value stays the page's.
+        }
+      }),
+    );
+    return out;
+  }
+
+  /** Reads what was asked for and sends what changed; one run at a time, the next after it. */
+  function run(): void {
+    if (running) return;
+    const parts = new Set(pending);
+    const reasons = [...why];
+    pending.clear();
+    why.clear();
+    if (clients.size === 0 || parts.size === 0) return;
+    stats.runs++;
+    const t0 = Date.now();
+    running = readParts(parts)
+      .then((read) => {
+        const changes: Record<string, unknown> = {};
+        for (const [part, text] of read) {
+          if (last.get(part) === text) continue;
+          last.set(part, text);
+          changes[part] = JSON.parse(text) as unknown;
+        }
+        if (Object.keys(changes).length > 0) {
+          event('change', { parts: changes, why: reasons, at: Date.now(), ms: Date.now() - t0 });
+        }
+      })
+      .finally(() => {
+        running = null;
+        if (pending.size > 0) schedule();
+      });
+  }
+  function schedule(): void {
+    clearTimeout(timer);
+    timer = setTimeout(run, DEBOUNCE_MS);
+  }
+
+  /** Something may have changed `parts`. */
+  function trigger(parts: Iterable<Part>, reason: string): void {
+    stats.triggers++;
+    for (const part of parts) pending.add(part);
+    why.add(reason);
+    if (pending.has('workspaces')) fresh.sessions = true;
+    schedule();
+  }
+
+  bus.addEventListener('part', (e) => trigger([(e as CustomEvent<Part>).detail], 'memory'));
+
+  // Hooks' pings: HTTP (`ping`) or one UDP datagram on the same port number.
+  const settle = (reason: string) => {
+    trigger(['workspaces'], reason);
+    for (const ms of SETTLE_MS) setTimeout(() => trigger(['workspaces'], `${reason}+${ms}`), ms);
+  };
+  let udp: ReturnType<typeof createSocket> | null = null;
+  if (MODE === 'ping' || MODE === 'both') {
+    udp = createSocket('udp4');
+    udp.on('message', () => settle('udp'));
+    udp.on('error', () => udp?.close());
+    udp.bind(options.port, '127.0.0.1');
+  }
+
+  // Files watched: the records, reviews, threads and activity; git's refs for commits. One plain
+  // watch per folder, folders added as they appear: Node's recursive watch on Linux misses a
+  // write by rename after the second, and says nothing when its folder is not there yet (spike).
+  const watchers: FSWatcher[] = [];
+  const trees: { close(): void }[] = [];
+  if (MODE === 'watch' || MODE === 'both') {
+    const symbiote = join(options.root, 'symbiote');
+    const partsOf = (path: string): Part[] =>
+      path.startsWith(join(symbiote, 'reviews')) ? ['reviews', 'workspaces'] : ['workspaces'];
+    trees.push(
+      watchTree(options.root, 'symbiote', (path) => trigger(partsOf(path), `watch:${path.slice(options.root.length + 1)}`)),
+    );
+    let common = '';
+    try {
+      common = execFileSync('git', ['rev-parse', '--path-format=absolute', '--git-common-dir'], {
+        cwd: options.root,
+        encoding: 'utf8',
+      }).trim();
+    } catch {
+      // Not a repository.
+    }
+    if (common) {
+      trees.push(watchTree(join(common, 'refs'), 'heads', () => trigger(['workspaces', 'reviews'], 'watch:refs')));
+      try {
+        watchers.push(
+          watch(common, (_kind, name) => {
+            if (name === 'packed-refs') trigger(['workspaces', 'reviews'], 'watch:packed-refs');
+          }),
+        );
+      } catch {
+        // Gone.
+      }
+    }
+  }
+
+  const keepalive = setInterval(() => {
+    for (const res of clients) write(res, ': ka\n\n');
+  }, KEEPALIVE_MS);
+  const safety = setInterval(() => trigger(PARTS, 'safety'), SAFETY_MS);
+
+  return {
+    stats,
+    clients,
+    /** `GET /api/events`: the whole state, then changes. */
+    async open(req: IncomingMessage, res: ServerResponse): Promise<void> {
+      res.writeHead(200, {
+        'content-type': 'text/event-stream',
+        'cache-control': 'no-store',
+        connection: 'keep-alive',
+      });
+      write(res, 'retry: 1000\n\n');
+      clients.add(res);
+      req.on('close', () => clients.delete(res));
+      fresh.sessions = true;
+      const read = await readParts(PARTS);
+      const parts: Record<string, unknown> = {};
+      for (const [part, text] of read) {
+        last.set(part, text);
+        parts[part] = JSON.parse(text) as unknown;
+      }
+      if (!clients.has(res)) return;
+      const text = `event: state\ndata: ${JSON.stringify({ parts, at: Date.now() })}\n\n`;
+      write(res, text);
+    },
+    /** `POST /api/events/ping`: a hook wrote. */
+    ping(): void {
+      settle('http');
+    },
+    /** For the spike's reliability cases: every stream cut. */
+    drop(): void {
+      for (const res of clients) res.destroy();
+      clients.clear();
+    },
+    close(): void {
+      clearInterval(keepalive);
+      clearInterval(safety);
+      clearTimeout(timer);
+      for (const w of watchers) w.close();
+      for (const t of trees) t.close();
+      // An open socket keeps the process: a server that does not stop (found on the spike's runs).
+      udp?.close();
+      for (const res of clients) res.end();
+    },
+  };
+}
+
+/**
+ * Watches `<parent>/<name>` and every folder under it, each with a plain watch; a folder made
+ * later is added when its parent says so, and `<name>` itself once it is made.
+ */
+function watchTree(parent: string, name: string, onChange: (path: string) => void): { close(): void } {
+  const watchers = new Map<string, FSWatcher>();
+  const root = join(parent, name);
+  const add = (dir: string) => {
+    if (watchers.has(dir)) return;
+    let w: FSWatcher;
+    try {
+      w = watch(dir, (_kind, file) => {
+        const path = join(dir, String(file ?? ''));
+        onChange(path);
+        let folder = false;
+        try {
+          folder = statSync(path).isDirectory();
+        } catch {
+          // Gone: its watch ends with it.
+        }
+        if (folder) addTree(path);
+      });
+    } catch {
+      return;
+    }
+    w.on('error', () => {
+      w.close();
+      watchers.delete(dir);
+    });
+    watchers.set(dir, w);
+  };
+  const addTree = (dir: string) => {
+    add(dir);
+    let entries: import('node:fs').Dirent[] = [];
+    try {
+      entries = readdirSync(dir, { withFileTypes: true });
+    } catch {
+      return;
+    }
+    for (const e of entries) if (e.isDirectory()) addTree(join(dir, e.name));
+  };
+  // The parent, for `name` made (or made again) after the watch started.
+  let top: FSWatcher | null = null;
+  try {
+    top = watch(parent, (_kind, file) => {
+      if (String(file) === name) addTree(root);
+    });
+  } catch {
+    // No parent: nothing to watch.
+  }
+  addTree(root);
+  return {
+    close() {
+      top?.close();
+      for (const w of watchers.values()) w.close();
+      watchers.clear();
+    },
+  };
+}
