    {
      "id": 2,
      "type": "stat",
      "title": "Crashes",
      "description": "Uncaught errors (`fatal`): the process ended. Each is listed below with its stack.",
      "datasource": {
        "type": "loki",
        "uid": "symbiote-loki"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "symbiote-loki"
          },
          "expr": "sum(count_over_time({service_name=\"symbiote\", process=~\"$process\", level=\"fatal\"} [$__range]))",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
