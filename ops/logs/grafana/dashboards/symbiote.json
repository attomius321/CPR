    {
      "id": 9,
      "type": "timeseries",
      "title": "Problems over time",
      "description": "Crashes, errors and warnings in each interval, by level.",
      "datasource": {
        "type": "loki",
        "uid": "symbiote-loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "maxDataPoints": 60,
      "interval": "1m",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "symbiote-loki"
          },
          "expr": "sum by (level) (count_over_time({service_name=\"symbiote\", process=~\"$process\", level=~\"fatal|error|warn\"} [$__auto]))",
          "queryType": "range",
          "legendFormat": "{{level}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisSoftMin": 0,
            "fillOpacity": 90,
            "gradientMode": "none",
            "lineWidth": 0,
            "showPoints": "never",
            "spanNulls": false,
            "drawStyle": "bars",
            "barAlignment": 0,
            "barWidthFactor": 0.8,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "decimals": 0,
          "unit": "none"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "fatal"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "warn"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Problems by kind",
      "description": "Crashes, errors and warnings over the time range, one row a kind: its level, the program that wrote it and its message.",
      "datasource": {
        "type": "loki",
        "uid": "symbiote-loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "symbiote-loki"
          },
          "expr": "sum by (level, process, msg) (count_over_time({service_name=\"symbiote\", process=~\"$process\", level=~\"fatal|error|warn\"} | json msg [$__range]))",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "level": 0,
              "process": 1,
              "msg": 2,
              "Value #A": 3
            },
            "renameByName": {
              "msg": "message",
              "Value #A": "count"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "count",
                "desc": true
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "fatal": {
                  "color": "purple",
                  "index": 0
                },
                "error": {
                  "color": "red",
                  "index": 1
                },
                "warn": {
                  "color": "orange",
                  "index": 2
                }
              }
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "level"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "process"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 96
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "count"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          }
        ]
      }
    },
    {
      "id": 11,
      "type": "logs",
      "title": "Crashes, errors and warnings, with their stacks",
      "description": "Newest first. A row says what happened; a stack is under its row. Opened, a row shows all its fields.",
      "datasource": {
        "type": "loki",
        "uid": "symbiote-loki"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "symbiote-loki"
          },
          "expr": "{service_name=\"symbiote\", process=~\"$process\", level=~\"fatal|error|warn\"} |~ \"(?i)$search\" | json | line_format \"{{.process}} · {{.msg}}{{if .pair}} {{.pair}}{{end}}{{if .branch}} {{.branch}}{{if .into}} → {{.into}}{{end}}{{end}}{{if .program}} {{.program}}{{end}}{{if .method}} {{.method}} {{.path}} {{.status}}{{end}}{{if .type}} {{.type}}{{end}}{{if .description}} {{.description}}{{end}}{{if .repo}} {{.repo}}{{else if .url}} {{.url}}{{end}}{{if .page}} {{.page}}{{end}}{{if .from}} from {{.from}}{{end}}{{if .ms}}{{if ge (int .ms) 1000}} {{printf \\\"%.1f\\\" (divf .ms 1000)}} s{{else}} {{.ms}} ms{{end}}{{end}}{{if .signal}} ({{.signal}}){{else if and .exitCode (ne .exitCode \\\"0\\\")}} (exit {{.exitCode}}){{else if and .code (not .description)}} (exit {{.code}}){{end}}{{if .reason}} ({{.reason}}){{end}}{{if .repeated}} ×{{.repeated}}{{end}}{{if and .err_message (ne .err_message .msg)}} — {{regexReplaceAll \\\"(?s)\\\\n.*$\\\" .err_message \\\"\\\"}}{{else if .answer}} — {{regexReplaceAll \\\"(?s)\\\\n.*$\\\" .answer \\\"\\\"}}{{end}}{{if .err_stack}}\\n{{regexReplaceAll \\\"(?s)^((?:[^\\\\n]*\\\\n){5}[^\\\\n]*)\\\\n.*$\\\" .err_stack \\\"$1\\\\n    …\\\"}}{{end}}{{if .componentStack}}\\n{{regexReplaceAll \\\"(?s)^((?:[^\\\\n]*\\\\n){5}[^\\\\n]*)\\\\n.*$\\\" .componentStack \\\"$1\\\\n    …\\\"}}{{end}}{{if .stderr}}\\n{{regexReplaceAll \\\"(?s)^((?:[^\\\\n]*\\\\n){5}[^\\\\n]*)\\\\n.*$\\\" .stderr \\\"$1\\\\n    …\\\"}}{{end}}\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "enableInfiniteScrolling": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
