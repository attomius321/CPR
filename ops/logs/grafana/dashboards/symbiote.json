{
  "uid": "symbiote",
  "title": "Symbiote",
  "description": "Symbiote's own lines (LG1, LG2): every Symbiote process, read from its log folder by Alloy. Process filters every panel; Text every list of lines; Level the last list.",
  "tags": ["symbiote"],
  "editable": false,
  "graphTooltip": 1,
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "schemaVersion": 41,
  "version": 1,
  "links": [
    {
      "title": "Logs Drilldown",
      "type": "link",
      "url": "/a/grafana-lokiexplore-app/explore",
      "icon": "external link",
      "tooltip": "Every line by level and process, and its fields, without writing a query",
      "targetBlank": false,
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "tags": []
    },
    {
      "title": "Explore",
      "type": "link",
      "url": "/explore?schemaVersion=1&panes=%7B%22a%22%3A%7B%22datasource%22%3A%22symbiote-loki%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22type%22%3A%22loki%22%2C%22uid%22%3A%22symbiote-loki%22%7D%2C%22expr%22%3A%22%7Bservice_name%3D%5C%22symbiote%5C%22%7D%20%7C%20json%22%2C%22queryType%22%3A%22range%22%2C%22editorMode%22%3A%22code%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22now-24h%22%2C%22to%22%3A%22now%22%7D%7D%7D",
      "icon": "external link",
      "tooltip": "A query of your own: {service_name=\"symbiote\"} | json",
      "targetBlank": false,
      "asDropdown": false,
      "includeVars": false,
      "keepTime": false,
      "tags": []
    }
  ],
  "templating": {
    "list": [
      {
        "name": "process",
        "label": "Process",
        "description": "The program that wrote the line: view (the server), app, viewer (the pages), analysis…",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "symbiote-loki"
        },
        "query": {
          "refId": "process",
          "type": 1,
          "label": "process",
          "stream": "{service_name=\"symbiote\"}"
        },
        "definition": "label_values({service_name=\"symbiote\"}, process)",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": ["All"],
          "value": ["$__all"]
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "level",
        "label": "Level",
        "description": "The levels Every line shows.",
        "type": "custom",
        "query": "fatal,error,warn,info,debug",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": ["All"],
          "value": ["$__all"]
        },
        "options": []
      },
      {
        "name": "search",
        "label": "Text",
        "description": "Only lines holding this text, in any case: every list of lines.",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "At a glance",
      "collapsed": false,
      "gridPos": {
